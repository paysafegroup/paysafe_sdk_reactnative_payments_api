{
  "name": "@paysafe/paysafe-google-pay",
  "version": "2.0.0",
  "description": "google pay integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "Paysafe",
  "homepage": "https://github.com/paysafe/paysafe-sdk",
  "license": "SEE LICENSE IN LICENSE",
  "publishConfig": {
    "access": "public"
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-swift",
    "version": "0.48.3"
  },
  "codegenConfig": {
    "name": "PaysafeGooglePaySpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.paysafegooglepay"
    }
  },
  "peerDependencies": {
    "@paysafe/paysafe-payments-sdk-common": "^2.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.76.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@paysafe/paysafe-payments-sdk-common": "file:../paysafe-payments-sdk-common",
    "typescript": "^5.6.2",
    "react-test-renderer": "18.3.1"
  },
  "peerDependenciesMeta": {
    "@paysafe/paysafe-payments-sdk-common": {
      "optional": false
    },
    "react": {
      "optional": false
    },
    "react-native": {
      "optional": false
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "src",
    "android"
  ],
  "react-native": {
    "android": {
      "sourceDir": "android"
    }
  }
}
